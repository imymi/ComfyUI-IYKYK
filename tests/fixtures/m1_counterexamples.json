{
  "schema_version": "1.0",
  "created_at": "2026-10-16",
  "purpose": "M1 反例夹具定义与基线行为复现/新功能预期对照库 (M1-D5 修订版)",
  "counterexamples": [
    {
      "id": "CE-HAND-01",
      "category": "hand_capacity",
      "title": "单手占用与单手持物合法共存反例",
      "description": "单手托腮姿势（占用 1 只手）+ 手持单反相机（占用 1 只手），总手部占用 <= 2，物理上完全可行，不应被过度约束删除",
      "inputs": {
        "free_text_path": {
          "pose": "sitting, hand on cheek, looking at viewer",
          "props": "holding compact camera with other hand"
        },
        "structured_atom_path": {
          "pose_atom": {
            "atom_id": "pose__hand_on_cheek__0_0",
            "text": "sitting, hand on cheek",
            "source_slot": "pose",
            "tag_order": 0,
            "span_order": 0,
            "facts": {
              "hand_state": "one_busy"
            },
            "origin": {
              "entry_point": "generator",
              "mode": "explicit",
              "selector": "pose",
              "selected_id": "hand_on_cheek"
            }
          },
          "props_atom": {
            "atom_id": "props__digital_camera_in_hand__1_0",
            "text": "digital camera in hand",
            "source_slot": "props",
            "tag_order": 1,
            "span_order": 0,
            "facts": {
              "prop_usage": "handheld",
              "hands_required": 1
            },
            "origin": {
              "entry_point": "generator",
              "mode": "explicit",
              "selector": "props",
              "selected_id": "digital_camera_in_hand"
            }
          }
        }
      },
      "baseline_status": "free_text_coexists_structured_reproduced_excessive_deletion",
      "baseline_behavior": {
        "free_text_path": {
          "result": "coexists_in_unmatched_free_text",
          "notes": "自由文本路径未命中 both_busy 关键词库，表面共存"
        },
        "structured_atom_path": {
          "rule_id": "pose_hand_occupation",
          "action": "drop",
          "reason_code": "busy_hands_remove_props",
          "dropped_target": "props__digital_camera_in_hand__1_0",
          "notes": "真实目录路径携带 hand_state='one_busy'，被 conflict_resolver:2744 强行当做双手占用，导致相机被过度误删"
        }
      },
      "target_m3_behavior": {
        "rule_id": "pose_hand_occupation",
        "capacity_model": "2-hand",
        "hands_available": 2,
        "hands_consumed": 2,
        "action": "retained_both",
        "expected_retention_rate": 1.0,
        "notes": "新手部容量模型计算 1 + 1 <= 2，无论文本还是结构化均判定合法共存，完全保留相机"
      }
    },
