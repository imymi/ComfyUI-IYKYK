{
  "title": "ExpressionsDataset",
  "type": "object",
  "required": [
    "emotions",
    "gaze_rules",
    "mouth_actions",
    "progression_phases"
  ],
  "properties": {
    "emotions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "gaze_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "mouth_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "progression_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "description",
          "stages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "phase": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage_name",
                "expression",
                "gaze",
                "mouth",
                "body"
              ],
              "additionalProperties": false,
              "properties": {
                "stage_name": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                },
                "gaze": {
                  "type": "string"
                },
                "mouth": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "leaf_tag": {
      "type": "object",
      "required": [
        "id",
        "text",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/definitions/semantic_facts"
        }
      }
    },
    "semantic_facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "space_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visible_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_topologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hand_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "prop_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "hands_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "emotion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaze": {
          "type": [
            "string",
            "null"
          ]
        },
        "occlusion": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_of_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "light_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "color_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capture_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "makeup_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "makeup_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "liquid_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "liquid_locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "liquid_amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutex_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
