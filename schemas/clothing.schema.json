          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hand_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "prop_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "hands_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "emotion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaze": {
          "type": [
