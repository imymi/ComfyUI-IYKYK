{
  "title": "ClothingDataset",
  "type": "object",
  "required": [
    "categories",
    "clothing_states",
    "clothing_nudity_linkage",
    "sfw_exposure_tiers",
    "cloth_transparency_tiers",
    "lingerie_wardrobe",
    "extension_policy"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "clothing_states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "clothing_nudity_linkage": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^L[1-6]$": {
          "type": "object",
          "required": [
            "general_tags",
            "style_overrides"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "state_name": {
              "type": "string"
            },
            "general_tags": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/leaf_tag"
              }
            },
            "style_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/leaf_tag"
                }
              }
            }
          }
        }
      }
    },
    "sfw_exposure_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "cloth_transparency_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "lingerie_wardrobe": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    },
    "extension_policy": {
      "type": "object",
      "required": [
        "L2",
        "L3",
        "L4"
      ],
      "additionalProperties": false,
      "properties": {
        "L2": {
          "type": "object",
          "required": [
            "exposure_ids",
            "transparency_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "exposure_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transparency_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "L3": {
          "type": "object",
          "required": [
            "exposure_ids",
            "transparency_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "exposure_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transparency_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "L4": {
          "type": "object",
          "required": [
            "exposure_ids",
            "transparency_ids",
            "wardrobe_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "exposure_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transparency_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "wardrobe_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "leaf_tag": {
      "type": "object",
      "required": [
        "id",
        "text",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/definitions/semantic_facts"
        }
      }
    },
    "semantic_facts": {
