{
  "title": "ImperfectionsDataset",
  "type": "object",
  "required": [
    "categories"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_zh",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "name_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/leaf_tag"
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "leaf_tag": {
      "type": "object",
      "required": [
        "id",
        "text",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/definitions/semantic_facts"
        }
      }
    },
    "semantic_facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "space_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visible_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_topologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hand_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "prop_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "hands_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "emotion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaze": {
          "type": [
            "string",
            "null"
          ]
        },
        "occlusion": {
          "type": [
            "string",
            "null"
          ]
        },
