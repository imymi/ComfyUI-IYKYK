          "type": [
            "string",
            "null"
          ]
        },
        "light_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "color_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capture_device": {
          "type": [
            "string",
            "null"
          ]
        },
