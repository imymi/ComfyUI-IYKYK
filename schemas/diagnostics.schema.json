{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IYKYKPromptDiagnosticsAudit",
  "description": "ComfyUI-IYKYK 诊断节点审计报告 JSON 契约 2.0 (Draft-7, 11 大顶层字段, 全对象 Fail-Closed)",
  "type": "object",
  "additionalProperties": false,
  "if": {
    "properties": {
      "schema_version": {
        "const": "1.0"
      }
    }
  },
  "then": {
    "required": [
      "schema_version",
      "effective_seed",
      "context_profile",
      "selections",
      "decisions",
      "rules_applied",
      "unresolved_conflicts",
      "counts"
    ]
  },
  "else": {
    "required": [
      "schema_version",
      "status",
      "effective_seed",
      "context_profile",
      "selections",
      "overrides",
      "decisions",
      "rules_applied",
      "unresolved_conflicts",
      "counts",
      "error_info"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error_info": {
            "$ref": "#/definitions/error_info_entry"
          }
        }
      },
      "else": {
        "properties": {
          "error_info": {
            "type": "null"
          }
        }
      }
    }
  ],
  "definitions": {
    "context_id": {
      "type": "string",
      "enum": [
        "adult",
        "bondage_sm",
        "dining",
        "domestic",
        "generic",
        "medical",
        "nightlife",
        "office",
        "onsen_bath",
        "outdoor",
        "school",
        "special",
        "traditional",
        "transit"
      ]
    },
    "rule_id": {
      "type": "string",
      "enum": [
        "spatial_environmental_mutual_exclusion",
        "nudity_clothing_conflicts",
        "framing_lower_body_coherence",
        "pose_hand_occupation",
        "handheld_props_single_holder",
        "clothing_style_state_coherence",
        "material_penetration",
        "device_quality_compatibility",
        "environmental_lighting_coherence",
        "monochrome_film_chroma_coherence",
        "makeup_details_coherence",
        "gaze_angle_geometry",
        "accessory_occlusion_gaze_coherence",
        "emotion_gaze_affinity",
        "gaze_mutual_exclusion",
        "liquid_restrictions",
        "tattoo_dermal_fusion"
      ]
    },
    "override_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_slot",
        "status",
        "source_port",
        "raw_input",
        "blank_fallback_reason",
        "replaced_target_ids",
        "replaced_texts",
        "injected_atom_ids"
      ],
      "properties": {
        "canonical_slot": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["applied", "fallback_blank", "not_provided"]
        },
        "source_port": {
          "type": ["string", "null"]
        },
        "raw_input": {},
        "blank_fallback_reason": {
          "type": ["string", "null"],
          "enum": ["omitted", "empty_string", "whitespace_only", "empty_list", null]
        },
        "replaced_target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replaced_texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "injected_atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sampling_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_contexts",
        "candidate_filter",
        "distribution",
        "fallback",
        "final_selection"
      ],
      "properties": {
        "active_contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_candidates",
            "excluded_hard_conflicts",
            "passed_candidates"
          ],
          "properties": {
            "total_candidates": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_hard_conflicts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "passed_candidates": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used",
            "reason"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "reason": {
              "type": ["string", "null"]
            }
          }
        },
        "final_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_id",
            "mode"
          ],
          "properties": {
            "selected_id": {
              "type": ["string", "null"]
            },
            "mode": {
              "type": "string"
            }
          }
        }
      }
    },
    "prop_demand_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "hands_required",
        "hand_state"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "hands_required": {
          "type": "integer",
          "minimum": 0
        },
        "hand_state": {
          "type": "string"
        }
      }
    },
    "prop_capacity_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_limit",
        "total_hands_demanded",
        "entity_demands"
      ],
      "properties": {
        "capacity_limit": {
          "type": "integer",
          "minimum": 0
        },
        "total_hands_demanded": {
          "type": "integer",
          "minimum": 0
        },
        "entity_demands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/prop_demand_entry"
          }
        }
      }
    },
    "fact_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "phase",
        "priority",
        "winner_objects",
        "target_objects"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "winner_objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prop_capacity": {
          "$ref": "#/definitions/prop_capacity_trace"
        }
      }
    },
    "error_info_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "error_code",
        "message",
        "slots",
        "texts",
        "rule_id",
        "details"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "external_override_hard_conflict",
            "invalid_input_type",
            "external_budget_exceeded",
            "slot_alias_collision",
            "unresolved_hard_conflict",
            "syntax_error",
            "generic_error"
          ]
        },
        "error_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_id": {
          "type": ["string", "null"]
        },
        "details": {
          "type": "object"
        }
      }
    },
    "atom_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "id",
        "is_accepted",
        "parent_ids",
        "semantic_ids",
        "source_item_id",
        "source_slot",
        "span_order",
        "tag_order",
        "target_id",
        "text"
      ],
      "properties": {
        "atom_id": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string"
        },
        "is_accepted": {
          "type": "boolean"
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantic_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_item_id": {
          "type": ["string", "null"]
        },
        "source_slot": {
          "type": "string"
        },
        "span_order": {
          "type": "integer",
          "minimum": 0
        },
        "tag_order": {
          "type": "integer",
          "minimum": 0
        },
        "target_id": {
          "type": ["string", "null"]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "deduplicated_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "basis",
        "retained_atom_id",
        "retained_tag_text"
      ],
      "properties": {
        "atom_id": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "retained_atom_id": {
          "type": "string"
        },
        "retained_tag_text": {
          "type": "string"
        }
      }
    },
    "budget_filtered_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "candidate_words",
        "reason",
        "used_words",
        "word_budget"
      ],
      "properties": {
        "atom_id": {
          "type": "string"
        },
        "candidate_words": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": ["word_budget_exceeded"]
        },
        "used_words": {
          "type": "integer",
          "minimum": 0
        },
        "word_budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selection_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_atoms",
        "budget_filtered_records",
        "deduplicated_records",
        "entry_point",
        "mode",
        "parent_ids",
        "produced_atoms",
        "raw_value",
        "selected_id",
        "selector",
        "source_atoms"
      ],
      "properties": {
        "accepted_atoms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/atom_entry"
          }
        },
        "budget_filtered_records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/budget_filtered_record"
          }
        },
        "deduplicated_records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/deduplicated_record"
          }
        },
        "entry_point": {
          "type": "string",
          "enum": ["generator", "preset_browser", "custom_combiner", "diagnostics"]
        },
        "mode": {
          "type": "string",
          "enum": ["none", "random", "auto", "explicit", "preset", "recipe", "custom", "override", "resolver"]
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produced_atoms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/atom_entry"
          }
        },
        "raw_value": {
          "type": ["string", "null"]
        },
        "sampling_rationale": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/sampling_rationale" }
          ]
        },
        "selected_id": {
          "type": ["string", "null"]
        },
        "selector": {
          "type": "string"
        },
        "source_atoms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/atom_entry"
          }
        }
      }
    },
    "drop_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "after_text",
        "before_text",
        "decision_id",
        "parent_source_ids",
        "phase",
        "produced_atom_ids",
        "reason_code",
        "rule_id",
        "sequence",
        "target_atom_id",
        "winner_atom_ids"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "drop"
        },
        "after_text": {
          "type": "null"
        },
        "before_text": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_trace": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/fact_trace" }
          ]
        },
        "parent_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": "string",
          "enum": ["anchors", "physical", "semantic", "effects"]
        },
        "produced_atom_ids": {
          "type": "array",
          "maxItems": 0
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "$ref": "#/definitions/rule_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "target_atom_id": {
          "type": "string",
          "minLength": 1
        },
        "winner_atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replace_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "after_text",
        "before_text",
        "decision_id",
        "parent_source_ids",
        "phase",
        "produced_atom_ids",
        "reason_code",
        "rule_id",
        "sequence",
        "target_atom_id",
        "winner_atom_ids"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "replace"
        },
        "after_text": {
          "type": "string",
          "minLength": 1
        },
        "before_text": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_trace": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/fact_trace" }
          ]
        },
        "parent_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": "string",
          "enum": ["anchors", "physical", "semantic", "effects"]
        },
        "produced_atom_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "$ref": "#/definitions/rule_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "target_atom_id": {
          "type": "string",
          "minLength": 1
        },
        "winner_atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inject_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "after_text",
        "before_text",
        "decision_id",
        "parent_source_ids",
        "phase",
        "produced_atom_ids",
        "reason_code",
        "rule_id",
        "sequence",
        "target_atom_id",
        "winner_atom_ids"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "inject"
        },
        "after_text": {
          "type": "string",
          "minLength": 1
        },
        "before_text": {
          "type": "null"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_trace": {
          "oneOf": [
            { "type": "null" },
