        },
        "parent_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": "string",
          "enum": ["anchors", "physical", "semantic", "effects"]
        },
        "produced_atom_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "$ref": "#/definitions/rule_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "target_atom_id": {
          "type": "null"
        },
        "winner_atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
