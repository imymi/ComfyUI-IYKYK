{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropsDataset",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name_zh"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name_zh": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name_zh", "tags"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name_zh": { "type": "string", "minLength": 1 },
                "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
