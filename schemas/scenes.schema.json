{
  "title": "ScenesDataset",
  "type": "object",
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "subcategory",
                "context_ids",
                "anchor_tags",
                "detail_tags"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                },
                "label": {
                  "type": "string"
                },
                "subcategory": {
                  "type": "string"
                },
                "context_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "anchor_tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/leaf_tag"
                  }
                },
                "detail_tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/leaf_tag"
                  }
                },
                "exclusive_group": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/leaf_tag"
                  }
                },
                "atmosphere": {
                  "type": "string"
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "leaf_tag": {
      "type": "object",
      "required": [
        "id",
        "text",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/definitions/semantic_facts"
        }
      }
    },
    "semantic_facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "space_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visible_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_topologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "garment_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hand_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "prop_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "hands_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "emotion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaze": {
          "type": [
            "string",
            "null"
          ]
        },
        "occlusion": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_of_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "light_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "color_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capture_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "makeup_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "makeup_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "liquid_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "liquid_locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "liquid_amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutex_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
